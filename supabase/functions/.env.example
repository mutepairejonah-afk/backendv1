# ─────────────────────────────────────────────────────────────────────────────
# Supabase Edge Functions — environment variables
# For local dev: supabase functions serve --env-file supabase/functions/.env
# For deployed functions: supabase secrets set KEY=value (one time, persists
# across deploys of every function in this project).
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by the
# Supabase platform for deployed functions -- you do NOT set them with
# `secrets set`. You only need them here for local `functions serve`.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJREPLACE_ME

# ── Clerk (for verifying the caller's session token) ──────────────────────────
CLERK_SECRET_KEY=sk_live_REPLACE_ME

# ── AI (used by the `ai` function) ─────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL_FREE=meta-llama/llama-3.1-8b-instruct
# OPENROUTER_MODEL_PREMIUM=deepseek/deepseek-r1:free
# OPENROUTER_MODEL_PRO=deepseek/deepseek-r1

# ── Admin (used by the `payments` function's admin-only endpoints) ───────────
ADMIN_CLERK_ID=user_REPLACE_ME
# ADMIN_CLERK_IDS=user_abc,user_xyz

# ── Realtime bridge (used by the `media` function's video/moment endpoints) ──
# Your Render web service's public base URL and the same secret value you set
# on Render as INTERNAL_FUNCTIONS_SECRET (see the Node app's .env.example).
RENDER_INTERNAL_URL=https://REPLACE_ME.onrender.com
INTERNAL_FUNCTIONS_SECRET=
