# ─────────────────────────────────────────────────────────────────────────────
# ChatApp Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
# Socket.IO is served on PORT; no separate signaling port is required.

# Comma-separated list of allowed CORS origins (in addition to *.replit.dev)
# e.g. ALLOWED_ORIGINS=https://myapp.com,https://myapp.pages.dev
ALLOWED_ORIGINS=

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_live_REPLACE_ME
# Clerk Dashboard -> Webhooks -> signing secret for /webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
# Clerk user ID(s) allowed to administer any group/channel from the backend.
# Use one ID, or comma-separated IDs for multiple backend administrators.
ADMIN_CLERK_ID=user_REPLACE_ME
# ADMIN_CLERK_IDS=user_abc,user_xyz

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJREPLACE_ME

# ── AI (only for src/socket.ts's realtime "ai:chat" event -- a same-process,
#    tightly-coupled call on a live socket connection. Every other AI feature
#    moved to the Supabase `ai` Edge Function; see supabase/functions/.env.example) ──
GEMINI_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL_FREE=meta-llama/llama-3.1-8b-instruct

# ── Internal bridge (for the Supabase Edge Functions in supabase/functions/) ──
# ai.ts, agent.ts, media.ts, and payments.ts moved to Supabase Edge Functions
# to keep this Node process light. This process still holds the only live
# Socket.IO connections, so the moved media endpoints call back here after
# writing to the DB, to trigger a realtime broadcast. Generate a long random
# value and set the SAME value as an Edge Function secret via
# `supabase secrets set INTERNAL_FUNCTIONS_SECRET=...`. See
# supabase/functions/README.md for the full Edge Functions env setup
# (OPENROUTER_API_KEY, GEMINI_API_KEY, etc. now live there, not here).
INTERNAL_FUNCTIONS_SECRET=

# ── TURN server (self-hosted coturn — see docker-compose.yml) ─────────────────
# TURN_SECRET must match coturn's --static-auth-secret exactly. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TURN_PUBLIC_HOST is the public IP or domain of the machine running coturn.
TURN_SECRET=
TURN_TTL_SECONDS=3600
TURN_PUBLIC_HOST=
TURN_PORT=3478
# Only needed if your TURN URLs don't follow the standard turn:<host>:<port> pattern
TURN_URLS=
# Xirsys dynamic TURN (preferred for Render; keep these server-side only).
# Create a channel at https://global.xirsys.net/dashboard/connect.
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=
