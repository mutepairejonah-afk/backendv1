# Local browser / Capacitor phone testing
# The backend binds to all interfaces so a phone on the same Wi-Fi can reach it.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
ALLOWED_ORIGINS=

# Copy the required server credentials from .env.example.
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJREPLACE_ME

# Optional AI / calls configuration
GEMINI_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL_FREE=meta-llama/llama-3.1-8b-instruct
TURN_SECRET=
TURN_PUBLIC_HOST=
TURN_PORT=3478
TURN_URLS=
TURN_TTL_SECONDS=3600
